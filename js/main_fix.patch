    ctx.shadowBlur = 20;
    ctx.shadowOffsetY = 10;
    ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
    drawRoundedRectPath(ctx, cardX, cardY, cardW, cardH, 20);
